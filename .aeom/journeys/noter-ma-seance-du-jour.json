{
  "name": "Noter ma séance du jour",
  "steps": [
    { "do": "open", "path": "/sessions/new" },
    { "do": "see", "text": "Aucun exercice" },
    { "do": "click", "target": { "role": "button", "name": "Exercice" } },
    { "do": "click", "target": { "role": "button", "name": "Chest Press" } },
    { "do": "fill", "target": { "role": "spinbutton", "name": "kg" }, "value": "70" },
    { "do": "fill", "target": { "role": "spinbutton", "name": "reps" }, "value": "10" },
    { "do": "click", "target": { "role": "button", "name": "Ajouter la série" } },
    { "do": "see", "text": "1 série" },
    { "do": "click", "target": { "role": "button", "name": "Terminer la séance" } },
    { "do": "click", "target": { "role": "button", "name": "Oui, clôture" } }
  ]
}
